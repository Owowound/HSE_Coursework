      m_Calls: []
  m_text: "\u0413\u0435\u0440\u043E\u0439 \u0441\u043C\u043E\u0433 \u0437\u0430\u043D\u043E\u0432\u043E
    \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0435 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B
    \u0438 \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
    \u0441\u0442\u0438\u0445\u0438\u0439\u043D\u044B\u0435 \u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u044F,
    \u0447\u0435\u043C \u0441\u043F\u0430\u0441 \u043D\u0430\u0440\u043E\u0434\u044B
    \u0421\u0442\u0438\u0445\u0438\u0439\u043D\u044B\u0445 \u0437\u0435\u043C\u0435\u043B\u044C.\n\u0422\u0435\u043F\u0435\u0440\u044C
    \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0447\u043D\u0435\u0442\u0441\u044F
    \u044D\u043F\u043E\u0445\u0430 \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u043D\u0438\u044F,
    \u043D\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E, \u0447\u0435\u043C
    \u043E\u043D\u0430 \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F \u0432 \u044D\u0442\u043E\u0442
    \u0440\u0430\u0437. \u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
    \u044D\u0442\u043E \u0443\u0436\u0435 \u0441\u043E\u0432\u0441\u0435\u043C \u0434\u0440\u0443\u0433\u0430\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u044F..."
